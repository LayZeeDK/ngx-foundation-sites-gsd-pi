{
  "name": "ngx-foundation-sites",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ngx-foundation-sites/src",
  "prefix": "lib",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "dependsOn": ["compile-default-css"],
      "options": {
        "project": "packages/ngx-foundation-sites/ng-package.json",
        "tsConfig": "packages/ngx-foundation-sites/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/ngx-foundation-sites/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "compile-default-css": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/css"],
      "options": {
        "command": "npx sass --quiet-deps --no-source-map --load-path=packages/ngx-foundation-sites/src/scss --load-path=node_modules packages/ngx-foundation-sites/src/lib/nfs-button/nfs-button.scss dist/packages/ngx-foundation-sites/css/nfs-button.css",
        "cwd": "{workspaceRoot}"
      }
    },
    "compodoc": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/compodoc/ngx-foundation-sites"],
      "options": {
        "command": "npx compodoc -p packages/ngx-foundation-sites/tsconfig.lib.json -d dist/compodoc/ngx-foundation-sites --disableGraph",
        "cwd": "{workspaceRoot}"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "exclude": ["**/*.browser.spec.ts"]
      }
    },
    "test-browser": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "browsers": ["ChromiumHeadless"],
        "include": ["**/*.browser.spec.ts"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "dependsOn": [
        "@ngx-foundation-sites/source:verify-browserslist",
        "verify-foundation-parity"
      ]
    },
    "verify-foundation-parity": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/scripts/verify-foundation-parity.mjs",
        "{projectRoot}/src/scss/**/*.scss",
        "{projectRoot}/src/lib/nfs-button/nfs-button.scss"
      ],
      "options": {
        "command": "node packages/ngx-foundation-sites/scripts/verify-foundation-parity.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "packages/ngx-foundation-sites/.storybook",
        "browserTarget": "ngx-foundation-sites:build-storybook",
        "compodoc": true,
        "compodocArgs": [
          "-e",
          "json",
          "-p",
          "packages/ngx-foundation-sites/tsconfig.lib.json",
          "-d",
          "packages/ngx-foundation-sites",
          "--disablePrivate",
          "--disableProtected"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["packages/ngx-foundation-sites/src/scss"]
        }
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/ngx-foundation-sites",
        "configDir": "packages/ngx-foundation-sites/.storybook",
        "browserTarget": "ngx-foundation-sites:build-storybook",
        "compodoc": true,
        "compodocArgs": [
          "-e",
          "json",
          "-p",
          "packages/ngx-foundation-sites/tsconfig.lib.json",
          "-d",
          "packages/ngx-foundation-sites",
          "--disablePrivate",
          "--disableProtected"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["packages/ngx-foundation-sites/src/scss"]
        }
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-storybook"],
      "options": {
        "command": "concurrently -k -s first -n server,tests \"nx run ngx-foundation-sites:static-storybook\" \"wait-on tcp:4400 && test-storybook -c packages/ngx-foundation-sites/.storybook --url=http://localhost:4400\""
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "port": 4400,
        "buildTarget": "ngx-foundation-sites:build-storybook",
        "staticFilePath": "dist/storybook/ngx-foundation-sites",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "ngx-foundation-sites:build-storybook:ci"
        }
      }
    }
  }
}
