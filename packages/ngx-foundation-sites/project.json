{
  "name": "ngx-foundation-sites",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ngx-foundation-sites/src",
  "prefix": "lib",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "dependsOn": ["compile-default-css"],
      "options": {
        "project": "packages/ngx-foundation-sites/ng-package.json",
        "tsConfig": "packages/ngx-foundation-sites/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/ngx-foundation-sites/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "compile-default-css": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/css"],
      "options": {
        "commands": [
          "node -e \"require('fs').mkdirSync('dist/packages/ngx-foundation-sites/css', { recursive: true })\"",
          "npx sass --load-path=node_modules/foundation-sites/scss --no-source-map packages/ngx-foundation-sites/src/scss/nfs-button.scss dist/packages/ngx-foundation-sites/css/nfs-button.css",
          "npx rtlcss --config packages/ngx-foundation-sites/.rtlcssrc.json dist/packages/ngx-foundation-sites/css/nfs-button.css dist/packages/ngx-foundation-sites/css/nfs-button.rtl.css"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "dependsOn": ["@ngx-foundation-sites/source:verify-browserslist"]
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "packages/ngx-foundation-sites/.storybook",
        "browserTarget": "ngx-foundation-sites:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/ngx-foundation-sites",
        "configDir": "packages/ngx-foundation-sites/.storybook",
        "browserTarget": "ngx-foundation-sites:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c packages/ngx-foundation-sites/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "ngx-foundation-sites:build-storybook",
        "staticFilePath": "dist/storybook/ngx-foundation-sites",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "ngx-foundation-sites:build-storybook:ci"
        }
      }
    }
  }
}
