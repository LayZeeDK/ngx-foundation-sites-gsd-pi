{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/packages/ngx-foundation-sites",
  "deleteDestPath": false,
  "assets": [
    {
      "glob": "**/*.scss",
      "input": "src/scss",
      "output": "scss"
    }
  ],
  "lib": {
    "entryFile": "src/index.ts",
    "styleIncludePaths": ["src/scss"]
  }
}
