{
  "name": "@ngx-foundation-sites/source",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "tmp/local-registry/storage"
      }
    },
    "verify-browserslist": {
      "executor": "nx:run-commands",
      "inputs": ["{workspaceRoot}/.browserslistrc"],
      "options": {
        "command": "node scripts/verify-browserslist.mjs",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
