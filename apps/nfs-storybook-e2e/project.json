{
  "name": "nfs-storybook-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/tsconfig.base.json"],
      "options": {
        "cwd": "apps/nfs-storybook-e2e",
        "command": "tsc -p tsconfig.json --noEmit"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/test-results"],
      "dependsOn": [
        "ngx-foundation-sites:verify-theming-bundle",
        "ngx-foundation-sites:static-storybook"
      ],
      "parallelism": true,
      "options": {
        "cwd": "apps/nfs-storybook-e2e",
        "command": "playwright test"
      }
    }
  }
}
