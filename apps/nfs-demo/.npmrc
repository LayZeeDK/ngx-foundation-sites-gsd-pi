# Points this isolated app's npm install at the local Verdaccio registry
# (see .verdaccio/config.yml and the root "local-registry" Nx target) so that
# `ngx-foundation-sites` is fetched as a real published tarball instead of
# being resolved from the monorepo's workspace symlink or tsconfig paths.
# All other packages transparently proxy through to the npmjs uplink.
registry=http://localhost:4873
